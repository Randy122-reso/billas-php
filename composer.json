{
    "name": "billas/billas-php",
    "description": "Billas v4 - hotspot voucher, PPPoE billing, QRIS unique guarantee, and RTRWNET WiFi captive portal in pure PHP.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "endroid/qr-code": "^5.0",
        "evilfreelancer/routeros-api-php": "^1.4",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^3.7",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3"
    },
    "autoload": {
        "psr-4": {
            "Billas\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Billas\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/console migrate",
        "seed": "php bin/console seed",
        "serve": "php -S 127.0.0.1:8080 -t public public/index.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
