# ============================================================================
# Billas v4 — environment template
# Copy to .env, fill every secret, then run:
#   docker compose up -d --build
# ============================================================================

# ---- Core -----------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_VERSION=4.0.0
APP_URL=https://billing.example.id
BASE_URL=https://billing.example.id
TZ=Asia/Jakarta
LOG_LEVEL=info
DB_PATH=/data/billas.db
LOG_DIR=/app/logs
APP_LISTEN_PORT=8080

# ---- Product modes --------------------------------------------------------
HOTSPOT_ENABLED=true
PPPOE_ENABLED=true

# ---- Features (v3) --------------------------------------------------------
FEATURE_HOTSPOT_CALENDAR_EXPIRY=true
FEATURE_PERSISTENT_ACCOUNT=false
FEATURE_SUBSCRIPTION_PAID_UNTIL=true

# ---- Feature D: unique QRIS + service guarantee (v4) ----------------------
FEATURE_PPOE_QRIS_UNIQUE=true
PPPOE_QRIS_UNIQUE_AUTO_CREATE=true
PPPOE_QRIS_UNIQUE_PROVIDERS=midtrans,xendit,duitku
# 0 = guarantee until invoice period_end; >0 adds a buffer in days.
PPPOE_SERVICE_GUARANTEE_DAYS=0

# ---- Feature E: RTRWNET captive portal (v4) -------------------------------
FEATURE_WIFI_CAPTIVE_PORTAL=true
WIFI_SSID=RTRWNET
WIFI_ALLOWED_SSIDS=RTRWNET
WIFI_BRAND_NAME=RTRWNET
WIFI_LOGO_URL=
WIFI_TERMS_URL=
WIFI_SESSION_TOKEN_TTL=1800
WIFI_PASSWORD_LENGTH=8
WIFI_CALENDAR_DAYS_DEFAULT=1
WIFI_MAX_PENDING_ORDERS_PER_MAC=2
WIFI_RATE_LIMIT_CREATE_PER_IP=5
WIFI_RATE_LIMIT_CREATE_PER_MAC=3

# ---- Feature F: Webhook Simulator (v4.2) -----------------------------------
# Admin-only operational tool. Keep OFF by default. In production the app
# refuses to boot when this is true unless the allow flag below is also true.
FEATURE_WEBHOOK_SIMULATOR=false
WEBHOOK_SIMULATOR_MODE=sign
WEBHOOK_SIMULATOR_ALLOW_IN_PRODUCTION=false

# ---- Cron -----------------------------------------------------------------
CRON_ENABLED=true
CRON_TOKEN=
CRON_HMAC_ENABLED=false
CRON_INTERVAL_INVOICES=86400
CRON_INTERVAL_ISOLIR=86400
CRON_INTERVAL_VOUCHERS=300
CRON_INTERVAL_ORDER_EXPIRE=900
CRON_INTERVAL_INVOICE_EXPIRE=900
CRON_INTERVAL_BACKUP=86400
CRON_INTERVAL_LOGS=86400
CRON_INTERVAL_CAPTIVE_SESSIONS=900
CRON_GRACE_ISOLIR_DAYS=3

# ---- Retry worker ---------------------------------------------------------
RETRY_INTERVAL=60
RETRY_MAX_ATTEMPTS=10
RETRY_BACKOFF_BASE=60

# ---- MikroTik default -----------------------------------------------------
# Use the docker bridge gateway so containers can reach a router API on the host.
MIKROTIK_HOST=172.17.0.1
MIKROTIK_PORT=8728
MIKROTIK_USER=billing-api
MIKROTIK_PASS=
MIKROTIK_TLS=false
MIKROTIK_FAKE=false
MIKROTIK_TIMEOUT=5

# ---- Payment routing ------------------------------------------------------
PAYMENT_DEFAULT_GATEWAY=tripay
PAYMENT_FALLBACK_CHAIN=tripay,midtrans,xendit,duitku,qris_static
PAYMENT_PERSISTENT_PROVIDERS=midtrans,xendit,duitku
PAYMENT_ORDER_TTL=900

# ---- Tripay ---------------------------------------------------------------
TRIPAY_MODE=sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_METHOD=QRIS

# ---- Midtrans -------------------------------------------------------------
MIDTRANS_MODE=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# ---- Xendit ---------------------------------------------------------------
XENDIT_MODE=sandbox
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_VA_BANK=BCA

# ---- Duitku ---------------------------------------------------------------
DUITKU_MODE=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=

# ---- Static QRIS fallback -------------------------------------------------
QRIS_STATIC_ENABLED=true
QRIS_STATIC_PAYLOAD=
QRIS_STATIC_MERCHANT_ID=
QRIS_STATIC_MERCHANT_NAME=
QRIS_STATIC_CITY=
QRIS_STATIC_POSTAL=
QRIS_STATIC_UNIQUE_CODE=true

# ---- Security (>= 16 chars; generate with `openssl rand -hex 32`) ---------
ENCRYPTION_KEY=
SESSION_SECRET=
WEBHOOK_SECRET=

# ---- Cloudflare Tunnel ----------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Docker bootstrap -----------------------------------------------------
AUTO_MIGRATE=1
AUTO_SEED=1
SEED_DEMO=0

# Initial admin account. Only used while the users table is EMPTY, so changing
# this later does not reset an existing password. Set a strong value before the
# first boot; never ship the default admin123 to production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-ME-before-first-boot
DEMO_CUSTOMER_PASSWORD=CHANGE-ME-if-SEED_DEMO

# ---- Optional local HTTP port mapping in docker-compose -------------------
BILLAS_HTTP_PORT=8080
